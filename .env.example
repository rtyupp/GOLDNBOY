# Market data (required for live data)
SIFTING_API_KEY=

# Optional OANDA Practice provider (not used by the default config)
# The default live feed is Swissquote Public Quotes and needs no key/account.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# Telegram signal delivery (optional in paper mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHANNEL_ID=

# Gemini review (optional only if ai.enabled is disabled)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional remote events file; leave empty unless explicitly needed.
EVENTS_CSV_URL=
