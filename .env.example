# كل مصادر الأسعار مجانية وبدون مفاتيح (Swissquote للّحظي + Dukascopy للتاريخ + Forex Factory للأخبار).
# المطلوب فقط:
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# paper = تسجيل فقط بلا إرسال إشارات (الافتراضي) | live = يرسل الإشارات لتيليجرام
BOT_MODE=paper

# اختياري
TELEGRAM_CHANNEL_ID=
SIGNAL_TARGET=
# Gemini مجاني لكنه معطّل افتراضيًا (ai.enabled: false)؛ املأه فقط إن فعّلته
GEMINI_API_KEY=
GEMINI_MODEL=
# رابط ping ذاتي لو لم يكن على Render (Render يضبط RENDER_EXTERNAL_URL تلقائيًا)
KEEPALIVE_URL=
# OANDA Practice حساب تجريبي مجاني (اختياري، غير مستخدم افتراضيًا)
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
EVENTS_CSV_URL=
