# Market data (required for live data)
SIFTING_API_KEY=

# OANDA Practice (recommended primary source: free demo, M1/M5 candles + stream)
# Create a practice account, then add the account ID and Personal Access Token.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# Telegram signal delivery (optional in paper mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHANNEL_ID=

# Gemini review (optional only if ai.enabled is disabled)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional remote events file; leave empty unless explicitly needed.
EVENTS_CSV_URL=
