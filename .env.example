# كل مصادر الأسعار مجانية وبدون مفاتيح (Swissquote للّحظي + Dukascopy للتاريخ).
# لا يوجد ذكاء اصطناعي ولا مصدر أخبار، فلا حاجة لأي مفتاح غير تيليجرام.
# لا تضع قيمًا حقيقية في هذا الملف ولا ترفع ملف .env إلى GitHub.

# مطلوب (من @BotFather ثم اكتب /id للبوت ليعطيك رقمك)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# paper = تسجيل فقط بلا إرسال إشارات (الافتراضي) | live = يرسل الإشارات لتيليجرام
BOT_MODE=paper

# اختياري
TELEGRAM_CHANNEL_ID=
SIGNAL_TARGET=
# رابط ping ذاتي لو لم يكن على Render (Render يضبط RENDER_EXTERNAL_URL تلقائيًا)
KEEPALIVE_URL=
# OANDA Practice حساب تجريبي مجاني (اختياري، غير مستخدم افتراضيًا)
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
